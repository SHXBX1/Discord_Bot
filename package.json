{
  "name": "meowpailong-bot",
  "version": "2.0.0",
  "description": "MeowPailong Discord bot: button roles, levels, logs, events, fun, birthdays, private voice rooms, music",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
